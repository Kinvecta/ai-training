# The "find the problems" exercise from the video, as a file you can scan.
# Do not use this. It is deliberately wrong in at least eight places (answers in README.md).
# The key value is a placeholder; the problem is that a key is here at all.

FROM python:latest
COPY . /app
RUN pip install -r /app/requirements.txt
ENV OPENAI_API_KEY=REDACTED
RUN rm /app/.env
CMD ["python", "/app/agent.py"]

